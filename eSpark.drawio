        <mxCell id="BhtPYsUqVhSGQNViGNbH-47" parent="BhtPYsUqVhSGQNViGNbH-46" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Variables:&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;Name&lt;div&gt;Dependencies (calculations KPIs needed)&lt;/div&gt;&lt;div&gt;Inputs (raw signals needed)&lt;/div&gt;&lt;div&gt;Other Variables (different per KPI)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Functions:&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Roll up&lt;/div&gt;&lt;div&gt;Finalize&lt;/div&gt;&lt;div&gt;Calculate&lt;/div&gt;" vertex="1">
