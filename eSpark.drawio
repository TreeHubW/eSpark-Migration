        <mxCell id="BhtPYsUqVhSGQNViGNbH-20" parent="BhtPYsUqVhSGQNViGNbH-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Data cleaning&lt;/h1&gt;&lt;div&gt;Have modular functions that take in DF along with other step specific parameters and output another DF with an extra column indicating the result or the passed values.&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="190" x="298" y="280" as="geometry" />
        </mxCell>
        <mxCell id="BhtPYsUqVhSGQNViGNbH-21" parent="BhtPYsUqVhSGQNViGNbH-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;KPI Calculations&lt;/h1&gt;&lt;div&gt;Each calculation is s class implementation that defines:&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- What the KPI depends on&lt;/div&gt;&lt;div&gt;- How to roll up the KPI&lt;/div&gt;&lt;div&gt;- Defines the steps for cleaning and implements calculating lowest grain value&lt;/div&gt;&lt;div&gt;- Holds other notes and specific implementations for that KPI&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="200" x="40" y="280" as="geometry" />
        </mxCell>
        <mxCell id="BhtPYsUqVhSGQNViGNbH-22" parent="BhtPYsUqVhSGQNViGNbH-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Rollups&lt;/h1&gt;&lt;div&gt;Houses logic for rolling up values, dynamically creates dependency graph and stages the order of roll ups. Defines KPI specific roll up logic if needed.&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="190" x="545" y="280" as="geometry" />
        </mxCell>
        <mxCell id="BhtPYsUqVhSGQNViGNbH-23" parent="BhtPYsUqVhSGQNViGNbH-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Runner&lt;/h1&gt;&lt;div&gt;Main starting point to orchestrate and run the pipeline. Which KPIs to use, what plants to calculate and for what values and for which period (monthly, daily, yearly, etc)&lt;br&gt;&lt;br&gt;Saves tables to be used by other processes&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="190" x="780" y="280" as="geometry" />
        </mxCell>
        <mxCell id="BhtPYsUqVhSGQNViGNbH-72" parent="BhtPYsUqVhSGQNViGNbH-1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;strokeColor=light-dark(#000000,#B014FF);" value="Mapping Table" vertex="1">
          <mxGeometry height="150" width="180" x="1030" y="80" as="geometry" />
        </mxCell>
        <mxCell id="BhtPYsUqVhSGQNViGNbH-73" parent="BhtPYsUqVhSGQNViGNbH-72" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Columns:&lt;/b&gt;&lt;div&gt;- Plant ID&lt;/div&gt;&lt;div&gt;- Calculation&lt;/div&gt;&lt;div&gt;- Signal ID&lt;/div&gt;&lt;div&gt;- Source System&lt;/div&gt;&lt;div&gt;- Grouping&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="180" y="30" as="geometry" />
        </mxCell>
